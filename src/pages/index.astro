---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Menu from '../components/Menu.astro';
import StickyHeader from '../components/StickyHeader.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import Sidebar from '../components/Sidebar.astro';

const profiles = await getCollection('profiles', ({ data }) => data.featured);
const featured = await getCollection('featured');

profiles.sort((a, b) => +b.data.date - +a.data.date);
---

<BaseLayout titleKey="site.title" descriptionKey="site.description">
  <div class="blog">
    <Menu />
    <StickyHeader
      title="Full-Stack"
      profileLabel="David Talavera"
      pageNumber="V 2.0"
    />

    <div class="blog-header-container">
      {
        profiles.map((profile) => (
          <FeaturedArticle
            bigTitle={profile.data.bigTitle}
            date={profile.data.date}
            emphasis={profile.data.emphasis}
            headline={profile.data.headline}
            cover={profile.data.cover}
            author={profile.data.author}
            excerpt={profile.data.excerpt}
            href={`/experience/${profile.id}`}
            translationKey={`experience.${profile.id}`}
          />
        ))
      }
    </div>

    <Sidebar entries={featured} />
  </div>
</BaseLayout>
