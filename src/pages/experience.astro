---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const items = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const profiles = (await getCollection('profiles', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date,
);
---

<PageLayout
  title="Experience"
  eyebrow="Professional background"
  description="Full-stack work across business automation, analytics, and web platforms."
  titleKey="experience.title"
  eyebrowKey="experience.eyebrow"
  descriptionKey="experience.description"
>
  {
    items.length === 0 ? (
      <p data-i18n="experience.empty">Experience entries are being prepared.</p>
    ) : (
      <div class="work-grid">
        {items.map((item) => {
          const Tag = item.data.url ? 'a' : 'div';
          return (
            <Tag
              class="work-item"
              href={item.data.url}
              target={item.data.url ? '_blank' : undefined}
              rel={item.data.url ? 'noopener' : undefined}
            >
              <img src={item.data.cover} alt="" loading="lazy" />
              <div class="work-item__year">{item.data.year}</div>
              <div class="work-item__title" data-i18n={`work.${item.id}.title`}>{item.data.title}</div>
              <div class="work-item__summary" data-i18n={`work.${item.id}.summary`}>{item.data.summary}</div>
            </Tag>
          );
        })}
      </div>
    )
  }
  <div class="post-list">
    {profiles.map((profile) => (
      <a class="post-card" href={`/experience/${profile.id}`}>
        <div class="post-card__cover">
          <img src={profile.data.cover} alt="Portfolio placeholder" loading="lazy" />
        </div>
        <div>
          <div class="post-card__meta">{profile.data.author}</div>
          <h2 class="post-card__title" data-i18n={`experience.${profile.id}.bigTitle`}>{profile.data.bigTitle}</h2>
          <p class="post-card__excerpt" data-i18n={`experience.${profile.id}.excerpt`}>{profile.data.excerpt}</p>
        </div>
      </a>
    ))}
  </div>
</PageLayout>
