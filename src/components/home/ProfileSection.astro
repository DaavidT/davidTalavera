---
import SectionHeader from './SectionHeader.astro';
import { defaultLocale, t } from '../../i18n';

const tr = (key: string, fallback: string) => t(defaultLocale, key, fallback);
---

<!-- Profile · the content that used to live on the profile page -->
<section class="profile-section" id="profile">
  <div class="section-container">
    <SectionHeader
      eyebrow="Profile"
      eyebrowKey="profile.eyebrow"
      title="About David"
      titleKey="profile.title"
      deck="Systems Engineer in Mexico City, specializing in process automation and applied AI."
      deckKey="profile.description"
    />

    <div class="profile-grid">
      <div class="profile-main">
        <p class="profile-lead" data-i18n="profile.intro">
          {
            tr(
              'profile.intro',
              'David Talavera is a Systems Engineer who designs automations, integrations, and applied AI solutions for business operations. His work connects processes, data, and software into maintainable systems.',
            )
          }
        </p>
      </div>

      <div class="profile-cards">
        <article class="profile-card">
          <h3 class="profile-card__title" data-i18n="profile.focusTitle">
            {tr('profile.focusTitle', 'Focus areas')}
          </h3>
          <p class="profile-card__text" data-i18n="profile.focusBody">
            {
              tr(
                'profile.focusBody',
                'Process automation, systems integration, data dashboards, ERP modules, and applied AI workflows. He also improves database performance and software architecture.',
              )
            }
          </p>
        </article>

        <article class="profile-card">
          <h3 class="profile-card__title" data-i18n="profile.backgroundTitle">
            {tr('profile.backgroundTitle', 'Background')}
          </h3>
          <p
            class="profile-card__text"
            data-i18n-html="profile.person1"
            set:html={tr(
              'profile.person1',
              '<strong>Universidad Tecnológica de México</strong> — Systems Engineering, 2020–2023.',
            )}
          />
          <p
            class="profile-card__text"
            data-i18n-html="profile.person2"
            set:html={tr(
              'profile.person2',
              '<strong>Languages</strong> — Native Spanish and B2 English.',
            )}
          />
          <p
            class="profile-card__text"
            data-i18n-html="profile.person3"
            set:html={tr(
              'profile.person3',
              '<strong>Certifications</strong> — OCI Foundations, terminal and command line, and CCNAv7 networking.',
            )}
          />
        </article>

        <article class="profile-card">
          <h3 class="profile-card__title" data-i18n="profile.contactTitle">
            {tr('profile.contactTitle', 'Location')}
          </h3>
          <p
            class="profile-card__text"
            data-i18n-html="profile.contactBody"
            set:html={tr(
              'profile.contactBody',
              'Based in Mexico City. Connect through the <a href="#about">contact section</a>.',
            )}
          />
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .profile-section {
    padding: 6rem 2rem;
    border-top: 1px solid var(--color-border);
  }

  .profile-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem;
    margin-top: 3.5rem;
  }

  .profile-lead {
    margin: 0;
    font-family: 'Space Grotesk', sans-serif;
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.4;
  }

  .profile-cards {
    display: grid;
    gap: 1.25rem;
  }

  .profile-card {
    padding: 1.75rem;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .profile-card__title {
    margin: 0 0 0.75rem;
    font-family: 'Space Grotesk', sans-serif;
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .profile-card__text {
    margin: 0 0 0.5rem;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .profile-card__text strong {
    color: var(--color-text-primary);
  }

  .profile-card__text a {
    color: var(--color-accent-text);
  }

  @media (max-width: 768px) {
    .profile-section {
      padding: 4rem 1.5rem;
    }

    .profile-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
