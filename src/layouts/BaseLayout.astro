---
import { defaultLocale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  titleKey?: string;
  descriptionKey?: string;
  i18nParams?: Record<string, string>;
}

const {
  title = 'David Talavera — Full-Stack Developer',
  description = 'Full-stack developer focused on business software, data, and applied AI exploration.',
  image,
  titleKey,
  descriptionKey,
  i18nParams,
} = Astro.props;

const site = Astro.site ?? new URL('https://davidtalavera.com');
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = image ? new URL(image, site).toString() : undefined;

// Person Schema for SEO
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "David Talavera",
  "url": "https://davidtalavera.com",
  "image": "https://davidtalavera.com/avatar.jpg",
  "jobTitle": "Solutions Architect & Full-Stack Developer",
  "description": "Full-stack developer and solutions architect specializing in business automation, analytics, and applied AI. Available for remote contracts.",
  "email": "davidtalavear33@gmail.com",
  "sameAs": [
    "https://www.linkedin.com/in/davidtalaveratorres"
  ],
  "knowsAbout": [
    "System Architecture",
    "Full-Stack Development",
    "Business Automation",
    "Applied AI",
    "Analytics",
    "TypeScript",
    "Node.js",
    "Python",
    "PostgreSQL"
  ]
};

// Organization Schema for SEO
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "David Talavera",
  "url": "https://davidtalavera.com",
  "email": "davidtalavear33@gmail.com",
  "description": "Full-stack developer and solutions architect specializing in business automation, analytics, and applied AI.",
  "sameAs": [
    "https://www.linkedin.com/in/davidtalaveratorres"
  ]
};
---

<!doctype html>
<html lang={defaultLocale} data-i18n-title={titleKey} data-i18n-description={descriptionKey} data-i18n-params={i18nParams ? JSON.stringify(i18nParams) : undefined}>
  <head>
    <!-- Preload Google Fonts to avoid render-blocking CSS import -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,400;1,500&family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" as="style" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,400;1,500&family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} data-i18n-description={descriptionKey} data-i18n-content={descriptionKey} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href="https://davidtalavera.com/" />
    <link rel="alternate" hreflang="x-default" href="https://davidtalavera.com/" />
    <link rel="alternate" type="application/rss+xml" title="David Talavera" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} data-i18n-content={titleKey} />
    <meta property="og:description" content={description} data-i18n-content={descriptionKey} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content="David Talavera - Solutions Architect & Full-Stack Developer" />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} data-i18n-content={titleKey} />
    <meta name="twitter:description" content={description} data-i18n-content={descriptionKey} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="twitter:creator" content="@davidtalavera_" />
    <meta name="twitter:site" content="@davidtalavera_" />

    <!-- Person Schema.org for SEO & Knowledge Panel -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    
    <!-- Organization Schema.org for SEO -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <title>{title}</title>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MMH3V986"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <slot />

    <!-- Google Tag Manager (moved to end of body for performance) -->
    <script defer>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MMH3V986');</script>
    <!-- End Google Tag Manager -->

    <!-- Google Analytics (Core Web Vitals monitoring) -->
    <script async defer src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script defer>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX', {
        'anonymize_ip': true,
        'allow_google_signals': false,
      });
    </script>

    <script>
      import '../scripts/language';
    </script>
  </body>
</html>

<style lang="scss" is:global>
  @use '../styles/global.scss';
</style>
