---
import { defaultLocale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  titleKey?: string;
  descriptionKey?: string;
  i18nParams?: Record<string, string>;
}

const {
  title = 'David Talavera — Full-Stack Developer',
  description = 'Full-stack developer focused on business software, data, and applied AI exploration.',
  image,
  titleKey,
  descriptionKey,
  i18nParams,
} = Astro.props;

const site = Astro.site ?? new URL('https://davidtalavera.com');
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = image ? new URL(image, site).toString() : undefined;
---

<!doctype html>
<html lang={defaultLocale} data-i18n-title={titleKey} data-i18n-description={descriptionKey} data-i18n-params={i18nParams ? JSON.stringify(i18nParams) : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} data-i18n-description={descriptionKey} data-i18n-content={descriptionKey} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="David Talavera" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} data-i18n-content={titleKey} />
    <meta property="og:description" content={description} data-i18n-content={descriptionKey} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} data-i18n-content={titleKey} />
    <meta name="twitter:description" content={description} data-i18n-content={descriptionKey} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/language';
    </script>
  </body>
</html>

<style lang="scss" is:global>
  @use '../styles/global.scss';
</style>
