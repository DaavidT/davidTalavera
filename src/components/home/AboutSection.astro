---
import { defaultLocale, t } from '../../i18n';

const tr = (key: string, fallback: string) => t(defaultLocale, key, fallback);
---

<!-- About Section · Hallmark redesign · CTA Hero -->
<section class="about-section-new" id="about">
  <div class="section-container">
    <div class="about-wrapper">
      <p class="about-dt-mark" aria-hidden="true">DT</p>

      <div class="about-headline-block">
        <h2
          class="about-headline"
          data-i18n-html="about.headline"
          set:html={tr(
            'about.headline',
            'Let\'s build<br />something<br /><span class="about-highlight">remarkable</span>.',
          )}
        />
        <p class="about-tagline" data-i18n="about.tagline">
          {
            tr(
              'about.tagline',
              'I help startups scale their technology — from concept to production.',
            )
          }
        </p>
      </div>

      <div class="cta-block">
        <a
          href="https://www.linkedin.com/in/davidtalaveratorres"
          target="_blank"
          rel="noopener noreferrer"
          class="cta-button cta-primary"
          data-i18n-aria-label="about.linkedinAria"
          aria-label={tr('about.linkedinAria', 'Connect with David on LinkedIn')}
        >
          <svg class="cta-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.475-2.236-1.986-2.236-1.081 0-1.722.731-2.004 1.437-.103.25-.129.599-.129.948v5.42h-3.554s.047-8.789 0-9.714h3.554v1.375c.427-.659 1.191-1.592 2.897-1.592 2.117 0 3.704 1.385 3.704 4.362v5.569zM5.337 8.855c-1.144 0-1.915-.759-1.915-1.71 0-.956.771-1.71 1.956-1.71 1.184 0 1.915.754 1.94 1.71 0 .951-.756 1.71-1.981 1.71zm1.581 11.597H3.715V9.638h3.203v10.814zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
            ></path>
          </svg>
          <span data-i18n="about.linkedin">{tr('about.linkedin', 'Connect on LinkedIn')}</span>
        </a>

        <a
          href="mailto:davidtalavear33@gmail.com"
          class="cta-button cta-secondary"
          data-i18n-aria-label="about.emailAria"
          aria-label={tr('about.emailAria', 'Send an email to David')}
        >
          <svg
            class="cta-icon"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <span data-i18n="about.email">{tr('about.email', 'Send an email')}</span>
        </a>
      </div>

      <p class="about-footer-text" data-i18n="about.footer">
        {tr('about.footer', "Available for remote contracts — Let's discuss your next project.")}
      </p>
    </div>
  </div>
</section>

<style>
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ============================================================
     About Section · Contact Links · Hallmark component-scope
     States: default · hover · focus-visible · active · disabled
     Contrast: pass (46–50) | Motion: reduced-motion respect
     ============================================================ */

  /* Hallmark · macrostructure: CTA Hero · tone: creative + professional
   * anchor: red (--color-accent-primary) · nav: N1b · footer: Ft5 · enrichment: none
   * component-scope: false | contrast: pass (46–50) | genre: editorial
   */

  /* On phones the fixed DT overlay is hidden, so the mark becomes part of the
   * layout here: it takes its own line and can never cover the headline or copy. */
  .about-dt-mark {
    display: none;
  }

  @media (max-width: 768px) {
    .about-dt-mark {
      display: block;
      margin: 0 0 1.5rem;
      font-family: 'Space Grotesk', sans-serif;
      font-size: var(--text-xl);
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0.04em;
      color: var(--color-text-primary);
    }
  }

  .about-section-new {
    background: linear-gradient(
      135deg,
      var(--color-bg-gradient-start) 0%,
      var(--color-bg-gradient-end) 100%
    );
    color: var(--color-text-primary);
    min-height: 55vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .about-wrapper {
    max-width: 800px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
  }

  .about-headline-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .about-headline {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -2px;
    color: var(--color-text-primary);
    font-style: normal;
    margin: 0;
    word-spacing: 100vw;
  }

  .about-highlight {
    display: inline-block;
    background: rgba(255, 255, 255, 0.15);
    padding: 0.5rem 1rem;
    border-radius: 8px;
    backdrop-filter: blur(10px);
    animation: float-up 3s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .about-highlight {
      animation: none;
    }
  }

  .about-tagline {
    font-size: var(--text-md);
    opacity: 0.9;
    line-height: 1.6;
    max-width: 600px;
    margin: 0;
    font-weight: 400;
  }

  /* CTA Block */

  .cta-block {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  /* CTA Button Base */

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.75rem;
    font-size: var(--text-base);
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition:
      transform var(--duration-base) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      color var(--duration-base) var(--ease-standard),
      opacity var(--duration-base) var(--ease-standard);
    white-space: nowrap;
    position: relative;
  }

  /* CTA Primary - LinkedIn */

  .cta-primary {
    background: rgba(255, 255, 255, 1);
    color: var(--color-accent-primary);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-primary:hover {
      transform: translateY(var(--hover-lift));
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
    }
  }

  .cta-primary:active {
    transform: translateY(0);
  }

  /* CTA Secondary - Email */

  .cta-secondary {
    background: rgba(255, 255, 255, 0.15);
    color: var(--color-text-primary);
    border: 2px solid rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(10px);
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-secondary:hover {
      background: rgba(255, 255, 255, 0.25);
      border-color: rgba(255, 255, 255, 0.6);
      transform: translateY(var(--hover-lift));
    }
  }

  .cta-secondary:active {
    transform: translateY(0);
  }

  /* CTA Icon */

  .cta-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cta-icon svg {
    width: 20px;
    height: 20px;
  }

  /* Footer Text */

  .about-footer-text {
    margin: 0;
    opacity: 0.85;
    font-size: var(--text-base);
    font-weight: 500;
    max-width: 500px;
  }

  @media (max-width: 414px) {
    .about-section-new {
      min-height: auto;
      padding: 3rem 1.5rem;
    }

    .about-wrapper {
      gap: 2rem;
    }

    .about-headline {
      font-size: var(--text-2xl);
    }

    .about-tagline {
      font-size: var(--text-base);
    }

    .cta-block {
      flex-direction: column;
      gap: 1rem;
      width: 100%;
    }

    .cta-button {
      width: 100%;
      justify-content: center;
      padding: 0.875rem 1.5rem;
      font-size: var(--text-base);
    }

    .about-footer-text {
      font-size: var(--text-sm);
    }
  }

  @media (min-width: 415px) and (max-width: 767px) {
    .about-headline {
      font-size: var(--text-3xl);
    }

    .cta-block {
      gap: 1rem;
    }

    .cta-button {
      padding: 0.875rem 1.5rem;
    }
  }

  @media (min-width: 768px) {
    .about-section-new {
      min-height: 55vh;
      padding: 8rem 2rem;
    }

    .about-headline {
      font-size: var(--text-display);
    }

    .cta-block {
      gap: 2rem;
    }

    .cta-button {
      padding: 1.125rem 2rem;
      font-size: var(--text-base);
    }
  }

  @keyframes float-up {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-8px);
    }
  }
</style>
