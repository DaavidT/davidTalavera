---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import LanguageToggle from '../components/LanguageToggle.astro';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  heroImage?: string;
  pageTitle?: string;
  titleKey?: string;
  descriptionKey?: string;
  eyebrowKey?: string;
  i18nParams?: Record<string, string>;
}

const { title, description, eyebrow, heroImage, pageTitle, titleKey, descriptionKey, eyebrowKey, i18nParams } = Astro.props;
const headTitle = pageTitle ?? `${title} — David Talavera`;
---

<BaseLayout title={headTitle} description={description} image={heroImage} titleKey={titleKey} descriptionKey={descriptionKey} i18nParams={i18nParams}>
  <div class="page">
    <header class="page-nav">
      <a class="page-nav__brand" href="/">David <span>T</span></a>
      <nav aria-label="Primary" data-i18n-aria-label="nav.primary">
        <a href="/profile" data-i18n="nav.profile">Profile</a>
        <a href="/experience" data-i18n="nav.experience">Experience</a>
        <a href="/skills" data-i18n="nav.skills">Skills</a>
        <a href="/contact" data-i18n="nav.contact">Contact</a>
        <LanguageToggle />
      </nav>
    </header>

    <main class="page-main">
      {
        heroImage && (
          <div class="page-hero">
            <img src={heroImage} alt="" />
          </div>
        )
      }

      <section class="page-head">
        {eyebrow && <div class="page-eyebrow" data-i18n={eyebrowKey}>{eyebrow}</div>}
        <h1 class="page-title" data-i18n={titleKey}>{title}</h1>
        {description && <p class="page-deck" data-i18n={descriptionKey}>{description}</p>}
      </section>

      <div class="page-body">
        <slot />
      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>
