---
import SectionHeader from './SectionHeader.astro';
import type { CollectionEntry } from 'astro:content';
import { defaultLocale, t } from '../../i18n';

const tr = (key: string, fallback: string) => t(defaultLocale, key, fallback);

interface Props {
  focusAreas: CollectionEntry<'featured'>[];
}

const { focusAreas } = Astro.props;
---

<!-- Skills Section · Hallmark redesign · Grid Layout -->
<section class="skills-section-new" id="skills">
  <div class="section-container">
    <SectionHeader
      eyebrow="Technical practice"
      eyebrowKey="skills.eyebrow"
      title="Capabilities and focus"
      titleKey="skills.title"
      deck="Automation, integration, data, and applied AI behind David's work."
      deckKey="skills.description"
    />

    <div class="skills-grid">
      <div class="skill-card">
        <div class="skill-card__icon">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <polyline points="23 4 23 10 17 10"></polyline>
            <polyline points="1 20 1 14 7 14"></polyline>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
          </svg>
        </div>
        <h3 class="skill-card__title" data-i18n="skills.automation">
          {tr('skills.automation', 'Automation')}
        </h3>
        <div class="skill-card__items">
          <span class="skill-item">Python</span>
          <span class="skill-item">JavaScript</span>
          <span class="skill-item">SQL</span>
          <span class="skill-item">REST</span>
          <span class="skill-item">JSON</span>
        </div>
      </div>

      <div class="skill-card">
        <div class="skill-card__icon">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <rect x="4" y="4" width="16" height="16" rx="2"></rect>
            <rect x="9" y="9" width="6" height="6"></rect>
            <line x1="9" y1="1" x2="9" y2="4"></line>
            <line x1="15" y1="1" x2="15" y2="4"></line>
            <line x1="9" y1="20" x2="9" y2="23"></line>
            <line x1="15" y1="20" x2="15" y2="23"></line>
            <line x1="20" y1="9" x2="23" y2="9"></line>
            <line x1="20" y1="14" x2="23" y2="14"></line>
            <line x1="1" y1="9" x2="4" y2="9"></line>
            <line x1="1" y1="14" x2="4" y2="14"></line>
          </svg>
        </div>
        <h3 class="skill-card__title" data-i18n="skills.appliedAi">
          {tr('skills.appliedAi', 'Applied AI')}
        </h3>
        <div class="skill-card__items">
          <span class="skill-item">LLMs</span>
          <span class="skill-item">Prompting</span>
          <span class="skill-item">Agents</span>
          <span class="skill-item">RAG</span>
          <span class="skill-item">Evals</span>
        </div>
      </div>

      <div class="skill-card">
        <div class="skill-card__icon">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
          </svg>
        </div>
        <h3 class="skill-card__title" data-i18n="skills.systemsData">
          {tr('skills.systemsData', 'Systems and data')}
        </h3>
        <div class="skill-card__items">
          <span class="skill-item">Oracle SQL</span>
          <span class="skill-item">SQL Server</span>
          <span class="skill-item">MongoDB</span>
          <span class="skill-item">MySQL</span>
          <span class="skill-item">APIs</span>
        </div>
      </div>

      <div class="skill-card">
        <div class="skill-card__icon">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
          </svg>
        </div>
        <h3 class="skill-card__title" data-i18n="skills.cloudDelivery">
          {tr('skills.cloudDelivery', 'Cloud and delivery')}
        </h3>
        <div class="skill-card__items">
          <span class="skill-item">Docker</span>
          <span class="skill-item">AWS</span>
          <span class="skill-item">Node.js</span>
          <span class="skill-item">Linux</span>
          <span class="skill-item">CI/CD</span>
        </div>
      </div>
    </div>

    <div
      class="skills-focus"
      aria-label={tr('skills.focusAria', 'Focus areas')}
      data-i18n-aria-label="skills.focusAria"
    >
      {
        focusAreas.map((area) => (
          <article class="focus-card">
            <span class="focus-card__index" aria-hidden="true">
              {String(area.data.order).padStart(2, '0')}
            </span>
            <h3 class="focus-card__title" data-i18n={`skill.${area.id}.title`}>
              {tr(`skill.${area.id}.title`, area.data.title)}
            </h3>
            <p class="focus-card__text" data-i18n={`skill.${area.id}.subtitle`}>
              {tr(`skill.${area.id}.subtitle`, area.data.subtitle)}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Hallmark · Skills Section redesign · Grid Layout
   * macrostructure: Bento Grid · tone: creative + professional
   * component-scope: false | contrast: pass (46–50)
   */

  .skills-section-new {
    width: 100%;
    padding: 6rem 2rem;
    position: relative;
    background: var(--color-surface-subtle);
  }

  /* Skills Grid */

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  /* Skill Card */

  .skill-card {
    padding: 2.5rem 2rem;
    border-radius: 12px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition:
      transform var(--duration-base) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      color var(--duration-base) var(--ease-standard),
      opacity var(--duration-base) var(--ease-standard);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  @media (hover: hover) and (pointer: fine) {
    .skill-card:hover {
      background: var(--color-surface-hover);
      border-color: var(--color-border-strong);
      box-shadow: var(--shadow-hover);
    }
  }

  /* Hover: only the icon moves. The card itself stays still. */

  /* Skill Card Icon */

  .skill-card__icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-accent-primary) 10%, transparent) 0%,
      color-mix(in srgb, var(--color-accent-dark) 5%, transparent) 100%
    );
    color: var(--color-accent-text);
    transition:
      transform var(--duration-base) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      color var(--duration-base) var(--ease-standard),
      opacity var(--duration-base) var(--ease-standard);
  }

  .skill-card:hover .skill-card__icon {
    background: linear-gradient(
      135deg,
      var(--color-accent-primary) 0%,
      var(--color-accent-dark) 100%
    );
    color: white;
    transform: rotate(8deg);
  }

  .skill-card__icon svg {
    width: 24px;
    height: 24px;
  }

  /* Skill Card Title */

  .skill-card__title {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    font-style: normal;
  }

  /* Skill Items */

  .skill-card__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .skill-item {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: color-mix(in srgb, var(--color-text-primary) 7%, transparent);
    border-radius: 6px;
    font-size: var(--text-sm);
    font-weight: 500;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
    white-space: nowrap;
  }

  /* Phones: compact cards, with the icon and title on one row and the tags below. */
  @media (max-width: 768px) {
    .skills-grid {
      gap: 1rem;
    }

    .skill-card {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      column-gap: 1rem;
      row-gap: 0.875rem;
      padding: 1.25rem;
    }

    .skill-card__icon {
      width: 2.75rem;
      height: 2.75rem;
      margin: 0;
    }

    .skill-card__items {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 414px) {
    .skills-section-new {
      padding: 3rem 1.5rem;
    }

    .skills-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .skill-card {
      padding: 2rem 1.5rem;
    }

    .skill-item {
      font-size: var(--text-xs);
      padding: 0.4rem 0.8rem;
    }
  }

  @media (min-width: 415px) and (max-width: 767px) {
    .skills-section-new {
      padding: 4rem 2rem;
    }

    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (min-width: 768px) {
    .skills-section-new {
      padding: 8rem 2rem;
    }

    .skills-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }
  }

  .skills-focus {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .focus-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .focus-card__index {
    font-family: 'Space Grotesk', sans-serif;
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent-text);
  }

  .focus-card__title {
    margin: 0;
    font-family: 'Space Grotesk', sans-serif;
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .focus-card__text {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
</style>
