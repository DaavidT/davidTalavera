---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const skills = (await getCollection('featured')).sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title="Skills and Focus"
  eyebrow="Technical practice"
  description="Technologies and areas of focus supporting David's full-stack work."
  titleKey="skills.title"
  eyebrowKey="skills.eyebrow"
  descriptionKey="skills.description"
>
  <div class="pg-grid">
    {
      skills.map((skill) => (
        <article class="pg-card pg-card--number">
          <div class="pg-card__body">
            <span class="pg-card__index" aria-hidden="true">
              {String(skill.data.order).padStart(2, '0')}
            </span>
            <h2 class="pg-card__title" data-i18n={`skill.${skill.id}.title`}>
              {skill.data.title}
            </h2>
            <p class="pg-card__text" data-i18n={`skill.${skill.id}.subtitle`}>
              {skill.data.subtitle}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</PageLayout>
