---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Contact"
  eyebrow="Let's connect"
  description="Available for full-stack development, technical collaboration, and applied AI conversations."
  titleKey="contact.title"
  eyebrowKey="contact.eyebrow"
  descriptionKey="contact.description"
>
  <div class="contact-links">
    <a
      href="https://www.linkedin.com/in/davidtalaveratorres/"
      aria-label="LinkedIn profile"
      data-i18n-aria-label="contact.linkedin"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M6.5 8.5H3.25V21H6.5V8.5ZM4.88 3A1.88 1.88 0 1 0 4.88 6.75 1.88 1.88 0 0 0 4.88 3ZM21 13.83c0-3.77-2.01-5.53-4.69-5.53-2.16 0-3.13 1.19-3.67 2.02V8.5H9.39V21h3.25v-6.19c0-1.63.31-3.21 2.33-3.21 1.99 0 2.02 1.86 2.02 3.32V21H21v-7.17Z" />
      </svg>
    </a>
    <a
      href="mailto:f2c8xxvm8@mozmail.com"
      aria-label="Email David Talavera"
      data-i18n-aria-label="contact.email"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M3 5.5A2.5 2.5 0 0 1 5.5 3h13A2.5 2.5 0 0 1 21 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 18.5v-13Zm2 .41v.36l7 4.67 7-4.67v-.36a.5.5 0 0 0-.5-.5h-13a.5.5 0 0 0-.5.5Zm14 12.68v-9.91l-6.45 4.3a1 1 0 0 1-1.1 0L5 8.68v9.91c0 .28.22.5.5.5h13a.5.5 0 0 0 .5-.5Z" />
      </svg>
    </a>
  </div>
</PageLayout>
