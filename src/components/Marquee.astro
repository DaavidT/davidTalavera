---
interface Props {
  items?: string[];
  class?: string;
}

const {
  items = [
    'Python, React, and business systems',
    'Data dashboards and ERP web modules',
    'Applied AI exploration and software architecture',
  ],
} = Astro.props;
---

<marquee width="100%" direction="left" class={Astro.props.class}>
  {items.map((text, index) => <span data-i18n={`home.marquee${index + 1}`}>{text}</span>)}
</marquee>
