---
import Backdrop from '../Backdrop.astro';
import { defaultLocale, t } from '../../i18n';

const tr = (key: string, fallback: string) => t(defaultLocale, key, fallback);
---

<section class="hero-section" id="hero">
  <Backdrop />
  <div class="hero-overlay">
    <div class="hero-content">
      <div class="hero-intro">
        <span class="hero-intro-label">David Talavera</span>
        <h1
          class="hero-intro-name"
          data-i18n-html="hero.name"
          set:html={tr('hero.name', 'Systems Engineer<br />Automation & Applied AI')}
        />
      </div>
      <a class="scroll-cue" href="#about">
        <span class="scroll-cue-rail" aria-hidden="true"></span>
        <span data-i18n="hero.scroll">{tr('hero.scroll', 'Scroll to explore')}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .hero-intro {
    display: none;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-intro-label {
    font-size: var(--text-sm);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: color-mix(in srgb, currentColor 62%, transparent);
    font-weight: 500;
  }

  .hero-intro-name {
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1.2;
    color: inherit;
    margin: 0;
    font-family: var(--font-display, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
  }

  /* The cue mirrors the backdrop's material: a signal travelling down a rail,
   * rather than the bouncing arrow every portfolio ships. */
  .scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    color: currentColor;
    text-decoration: none;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    opacity: 0.68;
    transition: opacity var(--duration-base) var(--ease-standard);
  }

  .scroll-cue:hover,
  .scroll-cue:focus-visible {
    opacity: 1;
  }

  .scroll-cue-rail {
    position: relative;
    display: block;
    width: 1px;
    height: 44px;
    overflow: hidden;
  }

  .scroll-cue-rail::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent, currentColor 26%, currentColor 100%);
    opacity: 0.22;
  }

  .scroll-cue-rail::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 16px;
    background: linear-gradient(to bottom, transparent, currentColor 65%, transparent);
    opacity: 0;
    animation: scroll-signal 2.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes scroll-signal {
    0% {
      transform: translateY(-16px);
      opacity: 0;
    }
    14% {
      opacity: 0.9;
    }
    62% {
      opacity: 0.9;
    }
    100% {
      transform: translateY(44px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue-rail::after {
      animation: none;
      opacity: 0.5;
      transform: translateY(14px);
    }
  }

  /* Full section height on phones, so the cue sits at the bottom instead of
   * touching the headline. */
  @media (max-width: 768px) {
    .hero-overlay {
      bottom: auto;
      height: 100%;
      padding: 1.5rem 1.5rem;
    }

    .hero-intro {
      display: flex;
    }

    .scroll-cue {
      margin-top: auto;
      padding-bottom: 2rem;
    }
  }

  @media (min-width: 769px) {
    .hero-overlay {
      justify-content: flex-end;
      padding: 2rem;
    }

    .hero-content {
      justify-content: flex-end;
      align-items: flex-start;
    }

    /* The cue sits under the name plate, on the same optical column. */
    .scroll-cue {
      padding-left: 4.4rem;
    }

    .hero-intro {
      display: none;
    }

    .scroll-cue {
      margin-bottom: 2rem;
    }
  }
</style>
