---
import { defaultLocale, t } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  titleKey?: string;
  descriptionKey?: string;
  i18nParams?: Record<string, string>;
}

const {
  title = 'David Talavera — Systems Engineer | Automation & AI',
  description = 'Systems Engineer specializing in process automation, systems integration, and applied AI.',
  image,
  titleKey,
  descriptionKey,
  i18nParams,
} = Astro.props;

const localizedTitle = titleKey ? t(defaultLocale, titleKey, title) : title;
const localizedDescription = descriptionKey
  ? t(defaultLocale, descriptionKey, description)
  : description;

const site = Astro.site ?? new URL('https://davidtalavera.com');
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = image ? new URL(image, site).toString() : undefined;

// Person Schema for SEO
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'David Talavera',
  url: 'https://davidtalavera.com',
  image: 'https://davidtalavera.com/avatar.jpg',
  jobTitle: 'Systems Engineer — Automation & Applied AI',
  description:
    'Systems Engineer specializing in process automation, systems integration, and applied AI. Available for remote contracts.',
  email: 'davidtalavear33@gmail.com',
  sameAs: ['https://www.linkedin.com/in/davidtalaveratorres'],
  knowsAbout: [
    'Process Automation',
    'Systems Integration',
    'Applied AI',
    'Business Systems',
    'Data Engineering',
    'Python',
    'SQL',
    'Node.js',
    'Cloud Infrastructure',
    'Software Architecture',
  ],
};

// Organization Schema for SEO
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'David Talavera',
  url: 'https://davidtalavera.com',
  email: 'davidtalavear33@gmail.com',
  description:
    'Systems Engineer specializing in process automation, systems integration, and applied AI.',
  sameAs: ['https://www.linkedin.com/in/davidtalaveratorres'],
};
---

<!doctype html>
<html
  lang={defaultLocale}
  data-i18n-title={titleKey}
  data-i18n-description={descriptionKey}
  data-i18n-params={i18nParams ? JSON.stringify(i18nParams) : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('david-talavera-language');
          if (saved === 'en') {
            document.documentElement.classList.add('i18n-loading');
          }
          if (saved === 'en' || saved === 'es') {
            document.documentElement.lang = saved;
            document.documentElement.dataset.locale = saved;
          }
          var theme = localStorage.getItem('david-talavera-theme');
          if (theme === 'dark' || theme === 'light') {
            document.documentElement.classList.add(theme);
            document.documentElement.style.colorScheme = theme;
          }
        } catch (error) {
          /* Storage can be unavailable; fall back to the server-rendered default. */
        }
      })();
    </script>
    <meta
      name="description"
      content={localizedDescription}
      data-i18n-description={descriptionKey}
      data-i18n-content={descriptionKey}
    />
    <meta name="theme-color" content="#ffffff" data-theme-color />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href="https://davidtalavera.com/" />
    <link rel="alternate" hreflang="x-default" href="https://davidtalavera.com/" />
    <link rel="alternate" type="application/rss+xml" title="David Talavera" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={localizedTitle} data-i18n-content={titleKey} />
    <meta
      property="og:description"
      content={localizedDescription}
      data-i18n-content={descriptionKey}
    />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {
      ogImage && (
        <meta
          property="og:image:alt"
          content="David Talavera - Systems Engineer, Automation & Applied AI"
        />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={localizedTitle} data-i18n-content={titleKey} />
    <meta
      name="twitter:description"
      content={localizedDescription}
      data-i18n-content={descriptionKey}
    />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="twitter:creator" content="@davidtalavera_" />
    <meta name="twitter:site" content="@davidtalavera_" />

    <!-- Person Schema.org for SEO & Knowledge Panel -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Organization Schema.org for SEO -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <title>{localizedTitle}</title>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-MMH3V986"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->

    <slot />

    <!-- Google Tag Manager (moved to end of body for performance) -->
    <script defer>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-MMH3V986');
    </script>
    <!-- End Google Tag Manager -->

    <!-- Google Analytics (Core Web Vitals monitoring) -->
    <script async defer src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script defer>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX', {
        anonymize_ip: true,
        allow_google_signals: false,
      });
    </script>

    <script>
      import '../scripts/language';
      import '../scripts/theme';
    </script>
  </body>
</html>

<style lang="scss" is:global>
  @use '../styles/global.scss';
</style>
