---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const items = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const profiles = (await getCollection('profiles', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date,
);
---

<PageLayout
  title="Experience"
  eyebrow="Professional background"
  description="Full-stack work across business automation, analytics, and web platforms."
  titleKey="experience.title"
  eyebrowKey="experience.eyebrow"
  descriptionKey="experience.description"
>
  {
    items.length === 0 ? (
      <p class="pg-empty" data-i18n="experience.empty">
        Experience entries are being prepared.
      </p>
    ) : (
      <div class="pg-grid">
        {items.map((item) => {
          const Tag = item.data.url ? 'a' : 'div';
          return (
            <Tag
              class="pg-card"
              href={item.data.url}
              target={item.data.url ? '_blank' : undefined}
              rel={item.data.url ? 'noopener' : undefined}
            >
              <div class="pg-card__media">
                <img
                  src={item.data.cover}
                  alt={item.data.title}
                  width="300"
                  height="200"
                  loading="lazy"
                />
              </div>
              <div class="pg-card__body">
                <div class="pg-card__meta">{item.data.year}</div>
                <h2 class="pg-card__title" data-i18n={`work.${item.id}.title`}>
                  {item.data.title}
                </h2>
                <p class="pg-card__text" data-i18n={`work.${item.id}.summary`}>
                  {item.data.summary}
                </p>
              </div>
            </Tag>
          );
        })}
      </div>
    )
  }

  {
    profiles.length > 0 && (
      <>
        <div class="pg-grid">
          {profiles.map((profile) => (
            <a class="pg-card" href={`/experience/${profile.id}`}>
              <div class="pg-card__media">
                <img
                  src={profile.data.cover}
                  alt="Portfolio placeholder"
                  width="300"
                  height="200"
                  loading="lazy"
                />
              </div>
              <div class="pg-card__body">
                <div class="pg-card__meta">{profile.data.author}</div>
                <h2 class="pg-card__title" data-i18n={`experience.${profile.id}.bigTitle`}>
                  {profile.data.bigTitle}
                </h2>
                <p class="pg-card__text" data-i18n={`experience.${profile.id}.excerpt`}>
                  {profile.data.excerpt}
                </p>
              </div>
            </a>
          ))}
        </div>
      </>
    )
  }
</PageLayout>
