---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelBackground from '../components/PixelBackground.astro';

// Fetch content collections
const workItems = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const profiles = (await getCollection('profiles', ({ data }) => data.featured)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 2);
const featured = (await getCollection('featured')).slice(0, 3);
---

<BaseLayout 
  title="Solutions Architect & Full-Stack Developer | David Talavera"
  description="Full-stack developer & solutions architect for startups. Business automation, analytics, applied AI. Remote contracts available."
  image="/og-image.png"
  titleKey="site.title"
  descriptionKey="site.description"
>
  <div class="portfolio-wrapper">
    <!-- Hero Section with Matrix Animation -->
    <section class="hero-section" id="hero">
      <PixelBackground />
      <div class="hero-overlay">
        <div class="hero-content">
          <div class="hero-intro">
            <span class="hero-intro-label">David Talavera</span>
            <h1 class="hero-intro-name">Solutions Architect<br>& Full-Stack Developer</h1>
          </div>
          <div class="scroll-indicator">
            <span>Scroll to explore</span>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 5v14M19 12l-7 7-7-7"></path>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- About Section · Hallmark redesign · CTA Hero -->
    <section class="about-section-new" id="about">
      <div class="section-container">
        <div class="about-wrapper">
          <div class="about-headline-block">
            <h2 class="about-headline">Let's build<br>something<br><span class="about-highlight">remarkable</span>.</h2>
            <p class="about-tagline">I help startups scale their technology — from concept to production.</p>
          </div>

          <div class="cta-block">
            <a 
              href="https://www.linkedin.com/in/davidtalaveratorres" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="cta-button cta-primary"
              aria-label="Connect with David on LinkedIn"
            >
              <svg class="cta-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.475-2.236-1.986-2.236-1.081 0-1.722.731-2.004 1.437-.103.25-.129.599-.129.948v5.42h-3.554s.047-8.789 0-9.714h3.554v1.375c.427-.659 1.191-1.592 2.897-1.592 2.117 0 3.704 1.385 3.704 4.362v5.569zM5.337 8.855c-1.144 0-1.915-.759-1.915-1.71 0-.956.771-1.71 1.956-1.71 1.184 0 1.915.754 1.94 1.71 0 .951-.756 1.71-1.981 1.71zm1.581 11.597H3.715V9.638h3.203v10.814zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
              </svg>
              <span>Connect on LinkedIn</span>
            </a>

            <a 
              href="mailto:davidtalavear33@gmail.com" 
              class="cta-button cta-secondary"
              aria-label="Send email to David"
            >
              <svg class="cta-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              <span>Send an email</span>
            </a>
          </div>

          <p class="about-footer-text">Available for remote contracts — Let's discuss your next project.</p>
        </div>
      </div>
    </section>

    <!-- Experience Section -->
    <section class="section experience-section" id="experience">
      <div class="section-container">
        <div class="section-header">
          <h2 class="section-title">Experience</h2>
          <p class="section-eyebrow">Recent work & portfolio</p>
        </div>
        
        {workItems.length > 0 ? (
          <div class="work-grid">
            {workItems.map((item) => (
              <a 
                href={item.data.url || '#'} 
                target={item.data.url ? '_blank' : undefined}
                rel={item.data.url ? 'noopener noreferrer' : undefined}
                class={`work-card ${item.data.title === 'HIR Seguros' ? 'work-card--small-image' : ''}`}
              >
                <div class="work-card__image">
                  <img src={item.data.cover} alt={`${item.data.title} - ${item.data.summary}`} loading="lazy" width="300" height="225" />
                </div>
                <div class="work-card__content">
                  <div class="work-card__year">{item.data.year}</div>
                  <h3 class="work-card__title">{item.data.title}</h3>
                  <p class="work-card__summary">{item.data.summary}</p>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p class="empty-state">Experience entries coming soon.</p>
        )}

        {profiles.length > 0 && (
          <div class="featured-grid">
            {profiles.map((profile) => (
              <a href={`/experience/${profile.id}`} class="featured-card">
                <div class="featured-card__image">
                  <img src={profile.data.cover} alt={profile.data.headline} loading="lazy" width="300" height="225" />
                </div>
                <div class="featured-card__content">
                  <p class="featured-card__meta">{profile.data.author}</p>
                  <h3 class="featured-card__title">{profile.data.headline}</h3>
                  <p class="featured-card__excerpt">{profile.data.excerpt}</p>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Skills Section · Hallmark redesign · Grid Layout -->
    <section class="skills-section-new" id="skills">
      <div class="section-container">
        <div class="skills-header">
          <div class="skills-header-content">
            <h2 class="skills-headline">What I build<br><span class="skills-highlight">with</span>.</h2>
            <p class="skills-subheader">Full-stack expertise across modern architecture, infrastructure, and development.</p>
          </div>
        </div>

        <div class="skills-grid">
          <div class="skill-card">
            <div class="skill-card__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </div>
            <h3 class="skill-card__title">Architecture</h3>
            <div class="skill-card__items">
              <span class="skill-item">System Design</span>
              <span class="skill-item">Microservices</span>
              <span class="skill-item">Cloud Infra</span>
              <span class="skill-item">Database Design</span>
              <span class="skill-item">API Design</span>
            </div>
          </div>

          <div class="skill-card">
            <div class="skill-card__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <polyline points="12 3 20 7.5 20 16.5 12 21 4 16.5 4 7.5 12 3"></polyline>
                <line x1="12" y1="12" x2="20" y2="7.5"></line>
                <line x1="12" y1="12" x2="12" y2="21"></line>
                <line x1="12" y1="12" x2="4" y2="7.5"></line>
              </svg>
            </div>
            <h3 class="skill-card__title">Backend</h3>
            <div class="skill-card__items">
              <span class="skill-item">TypeScript</span>
              <span class="skill-item">Node.js</span>
              <span class="skill-item">Python</span>
              <span class="skill-item">Go</span>
              <span class="skill-item">PostgreSQL</span>
            </div>
          </div>

          <div class="skill-card">
            <div class="skill-card__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </div>
            <h3 class="skill-card__title">Frontend</h3>
            <div class="skill-card__items">
              <span class="skill-item">React</span>
              <span class="skill-item">TypeScript</span>
              <span class="skill-item">Astro</span>
              <span class="skill-item">Vue.js</span>
              <span class="skill-item">Tailwind</span>
            </div>
          </div>

          <div class="skill-card">
            <div class="skill-card__icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
            </div>
            <h3 class="skill-card__title">Tools & DevOps</h3>
            <div class="skill-card__items">
              <span class="skill-item">Docker</span>
              <span class="skill-item">Kubernetes</span>
              <span class="skill-item">AWS</span>
              <span class="skill-item">CI/CD</span>
              <span class="skill-item">TDD</span>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- Footer -->
    <footer class="footer">
      <div class="footer-content">
        <p>&copy; {new Date().getFullYear()} David Talavera. All rights reserved.</p>
        <div class="footer-links">
          <a href="/skills">Skills</a>
          <a href="/experience">Experience</a>
          <a href="/contact">Contact</a>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  import { initParallax } from '../scripts/parallax';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initParallax);
  } else {
    initParallax();
  }

  // Smooth scroll to sections
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      const href = this.getAttribute('href');
      if (href && href !== '#') {
        e.preventDefault();
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      }
    });
  });

  // Scroll indicator fade-out on scroll
  const scrollIndicator = document.querySelector('.scroll-indicator');
  if (scrollIndicator) {
    window.addEventListener('scroll', () => {
      const opacity = Math.max(0, 1 - window.scrollY / 300);
      (scrollIndicator as HTMLElement).style.opacity = opacity.toString();
    });
  }
</script>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: #ffffff;
    color: #0b0b0d;
    line-height: 1.6;
  }

  @media (prefers-color-scheme: dark) {
    body {
      background: #0b0b0d;
      color: #ffffff;
    }
  }

  html.dark body {
    background: #0b0b0d;
    color: #ffffff;
  }

  html.light body {
    background: #ffffff;
    color: #0b0b0d;
  }
</style>

<style>
  .portfolio-wrapper {
    width: 100%;
    overflow-x: hidden;
  }

  /* Hero Section */
  .hero-section {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .hero-intro {
    display: none;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-intro-label {
    font-size: 0.875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 500;
  }

  .hero-intro-name {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: #ffffff;
    margin: 0;
    font-family: var(--font-display, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
  }

  .scroll-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9rem;
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  /* Sections */
  .section {
    width: 100%;
    padding: 6rem 2rem;
    position: relative;
  }

  .section:nth-child(even) {
    background: rgba(0, 0, 0, 0.02);
  }

  @media (prefers-color-scheme: dark) {
    .section:nth-child(even) {
      background: rgba(255, 255, 255, 0.02);
    }
  }

  html.dark .section:nth-child(even) {
    background: rgba(255, 255, 255, 0.02);
  }

  html.light .section:nth-child(even) {
    background: rgba(0, 0, 0, 0.02);
  }

  .section-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 4rem;
  }

  .section-eyebrow {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    opacity: 0.6;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -1px;
    line-height: 1.1;
  }

  /* ============================================================
     About Section · Contact Links · Hallmark component-scope
     States: default · hover · focus-visible · active · disabled
     Contrast: pass (46–50) | Motion: reduced-motion respect
     ============================================================ */

  /* Token block — locked colour references */
  :root {
    --color-accent-primary: #E31937;     /* Red accent */
    --color-accent-dark: #B8152B;        /* Red gradient end */
    --color-bg-gradient-start: #E31937;
    --color-bg-gradient-end: #B8152B;
    --color-text-primary: #ffffff;
    --color-text-secondary: rgba(255, 255, 255, 0.8);
    --color-focus: #ffffff;
    --color-link-underline: rgba(255, 255, 255, 0.4);
    --color-link-hover: #ffffff;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-accent-primary: #E31937;
      --color-accent-dark: #B8152B;
      --color-text-primary: #ffffff;
      --color-text-secondary: rgba(255, 255, 255, 0.8);
      --color-focus: #ffffff;
      --color-link-underline: rgba(255, 255, 255, 0.4);
      --color-link-hover: #ffffff;
    }
  }

  html.dark {
    --color-accent-primary: #E31937;
    --color-accent-dark: #B8152B;
    --color-text-primary: #ffffff;
    --color-text-secondary: rgba(255, 255, 255, 0.8);
    --color-focus: #ffffff;
    --color-link-underline: rgba(255, 255, 255, 0.4);
    --color-link-hover: #ffffff;
  }

  html.light {
    --color-accent-primary: #E31937;
    --color-accent-dark: #B8152B;
    --color-text-primary: #ffffff;
    --color-text-secondary: rgba(255, 255, 255, 0.8);
    --color-focus: #ffffff;
    --color-link-underline: rgba(255, 255, 255, 0.4);
    --color-link-hover: #ffffff;
  }

  /* Hallmark · macrostructure: CTA Hero · tone: creative + professional
   * anchor: red (#E31937) · nav: N1b · footer: Ft5 · enrichment: none
   * component-scope: false | contrast: pass (46–50) | genre: editorial
   */

  .about-section-new {
    background: linear-gradient(135deg, var(--color-bg-gradient-start) 0%, var(--color-bg-gradient-end) 100%);
    color: var(--color-text-primary);
    min-height: 55vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .about-wrapper {
    max-width: 800px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
  }

  .about-headline-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .about-headline {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -2px;
    color: var(--color-text-primary);
    font-style: normal;
    margin: 0;
    word-spacing: 100vw;
  }

  .about-highlight {
    display: inline-block;
    background: rgba(255, 255, 255, 0.15);
    padding: 0.5rem 1rem;
    border-radius: 8px;
    backdrop-filter: blur(10px);
    animation: float-up 3s ease-in-out infinite;
  }

  @keyframes float-up {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-highlight {
      animation: none;
    }
  }

  .about-tagline {
    font-size: 1.1rem;
    opacity: 0.9;
    line-height: 1.6;
    max-width: 600px;
    margin: 0;
    font-weight: 400;
  }

  /* CTA Block */
  .cta-block {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  /* CTA Button Base */
  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    position: relative;
  }

  /* CTA Primary - LinkedIn */
  .cta-primary {
    background: rgba(255, 255, 255, 1);
    color: var(--color-accent-primary);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
  }

  .cta-primary:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.8);
    outline-offset: 2px;
  }

  .cta-primary:active {
    transform: translateY(0);
  }

  /* CTA Secondary - Email */
  .cta-secondary {
    background: rgba(255, 255, 255, 0.15);
    color: var(--color-text-primary);
    border: 2px solid rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(10px);
  }

  .cta-secondary:hover {
    background: rgba(255, 255, 255, 0.25);
    border-color: rgba(255, 255, 255, 0.6);
    transform: translateY(-2px);
  }

  .cta-secondary:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.8);
    outline-offset: 2px;
  }

  .cta-secondary:active {
    transform: translateY(0);
  }

  /* CTA Icon */
  .cta-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cta-icon svg {
    width: 20px;
    height: 20px;
  }

  /* Footer Text */
  .about-footer-text {
    margin: 0;
    opacity: 0.85;
    font-size: 0.95rem;
    font-weight: 500;
    max-width: 500px;
  }

  /* Mobile · ≤414px */
  @media (max-width: 414px) {
    .about-section-new {
      min-height: auto;
      padding: 3rem 1.5rem;
    }

    .about-wrapper {
      gap: 2rem;
    }

    .about-headline {
      font-size: 2rem;
    }

    .about-tagline {
      font-size: 1rem;
    }

    .cta-block {
      flex-direction: column;
      gap: 1rem;
      width: 100%;
    }

    .cta-button {
      width: 100%;
      justify-content: center;
      padding: 0.875rem 1.5rem;
      font-size: 0.95rem;
    }

    .about-footer-text {
      font-size: 0.9rem;
    }
  }

  /* Tablet · 415px–767px */
  @media (min-width: 415px) and (max-width: 767px) {
    .about-headline {
      font-size: 2.75rem;
    }

    .cta-block {
      gap: 1rem;
    }

    .cta-button {
      padding: 0.875rem 1.5rem;
    }
  }

  /* Desktop · ≥768px */
  @media (min-width: 768px) {
    .about-section-new {
      min-height: 55vh;
      padding: 8rem 2rem;
    }

    .about-headline {
      font-size: 4rem;
    }

    .cta-block {
      gap: 2rem;
    }

    .cta-button {
      padding: 1.125rem 2rem;
      font-size: 1.05rem;
    }
  }

  .about-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
  }

  .about-text p {
    margin-bottom: 1.5rem;
    opacity: 0.85;
    line-height: 1.8;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .stat {
    padding: 2rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(10px);
  }

  @media (prefers-color-scheme: dark) {
    .stat {
      background: rgba(255, 255, 255, 0.05);
    }
  }

  html.dark .stat {
    background: rgba(255, 255, 255, 0.05);
  }

  html.light .stat {
    background: rgba(0, 0, 0, 0.03);
  }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 0.9rem;
    opacity: 0.7;
  }

  /* Experience Section */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .work-card {
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(10px);
