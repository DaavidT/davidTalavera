---
interface Props {
  title: string;
  profileLabel?: string;
  pageNumber?: string;
}

const { title, profileLabel = 'David Talavera', pageNumber = 'N.0.1' } = Astro.props;
---

<div class="blog-header blog-is-sticky">
  <div class="blog-article header-article">
    <div class="blog-big__title" data-i18n="home.software">{title}</div>
    <div class="blog-menu rounded small-title" data-i18n="home.profileLabel">{profileLabel}</div>
  </div>
  <div class="blog-article page-number">
    {pageNumber}
  </div>
</div>
