---
import SectionHeader from './SectionHeader.astro';
import type { CollectionEntry } from 'astro:content';
import { defaultLocale, t } from '../../i18n';

const tr = (key: string, fallback: string) => t(defaultLocale, key, fallback);

interface Props {
  focusAreas: CollectionEntry<'featured'>[];
}

const { focusAreas } = Astro.props;
---

<!-- Skills Section · Hallmark redesign · Grid Layout -->
<section class="skills-section-new" id="skills">
  <div class="section-container">
    <SectionHeader
      eyebrow="Technical practice"
      eyebrowKey="skills.eyebrow"
      title="What I build with."
      titleKey="skills.title"
      deck="Full-stack expertise across modern architecture, infrastructure, and development."
      deckKey="skills.description"
    />

    <div class="skills-grid">
      <div class="skill-card">
        <div class="skill-card__icon">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
        </div>
        <h3 class="skill-card__title" data-i18n="skills.architecture">
          {tr('skills.architecture', 'Architecture')}
        </h3>
        <div class="skill-card__items">
          <span class="skill-item">System Design</span>
          <span class="skill-item">Microservices</span>
          <span class="skill-item">Cloud Infra</span>
          <span class="skill-item">Database Design</span>
          <span class="skill-item">API Design</span>
        </div>
      </div>

      <div class="skill-card">
        <div class="skill-card__icon">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <polyline points="12 3 20 7.5 20 16.5 12 21 4 16.5 4 7.5 12 3"></polyline>
            <line x1="12" y1="12" x2="20" y2="7.5"></line>
            <line x1="12" y1="12" x2="12" y2="21"></line>
            <line x1="12" y1="12" x2="4" y2="7.5"></line>
          </svg>
        </div>
        <h3 class="skill-card__title" data-i18n="skills.backend">
          {tr('skills.backend', 'Backend')}
        </h3>
        <div class="skill-card__items">
          <span class="skill-item">TypeScript</span>
          <span class="skill-item">Node.js</span>
          <span class="skill-item">Python</span>
          <span class="skill-item">Go</span>
          <span class="skill-item">PostgreSQL</span>
        </div>
      </div>

      <div class="skill-card">
        <div class="skill-card__icon">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
        </div>
        <h3 class="skill-card__title" data-i18n="skills.frontend">
          {tr('skills.frontend', 'Frontend')}
        </h3>
        <div class="skill-card__items">
          <span class="skill-item">React</span>
          <span class="skill-item">TypeScript</span>
          <span class="skill-item">Astro</span>
          <span class="skill-item">Vue.js</span>
          <span class="skill-item">Tailwind</span>
        </div>
      </div>

      <div class="skill-card">
        <div class="skill-card__icon">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
        </div>
        <h3 class="skill-card__title" data-i18n="skills.tools">
          {tr('skills.tools', 'Tools & DevOps')}
        </h3>
        <div class="skill-card__items">
          <span class="skill-item">Docker</span>
          <span class="skill-item">Kubernetes</span>
          <span class="skill-item">AWS</span>
          <span class="skill-item">CI/CD</span>
          <span class="skill-item">TDD</span>
        </div>
      </div>
    </div>

    <div
      class="skills-focus"
      aria-label={tr('skills.focusAria', 'Focus areas')}
      data-i18n-aria-label="skills.focusAria"
    >
      {
        focusAreas.map((area) => (
          <article class="focus-card">
            <span class="focus-card__index" aria-hidden="true">
              {String(area.data.order).padStart(2, '0')}
            </span>
            <h3 class="focus-card__title" data-i18n={`skill.${area.id}.title`}>
              {tr(`skill.${area.id}.title`, area.data.title)}
            </h3>
            <p class="focus-card__text" data-i18n={`skill.${area.id}.subtitle`}>
              {tr(`skill.${area.id}.subtitle`, area.data.subtitle)}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Hallmark · Skills Section redesign · Grid Layout
   * macrostructure: Bento Grid · tone: creative + professional
   * component-scope: false | contrast: pass (46–50)
   */

  .skills-section-new {
    width: 100%;
    padding: 6rem 2rem;
    position: relative;
    background: rgba(255, 255, 255, 0.02);
  }

  @media (prefers-color-scheme: dark) {
    .skills-section-new {
      background: rgba(255, 255, 255, 0.02);
    }
  }

  html.dark .skills-section-new {
    background: rgba(255, 255, 255, 0.02);
  }

  html.light .skills-section-new {
    background: rgba(0, 0, 0, 0.02);
  }

  /* Skills Grid */

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  /* Skill Card */

  .skill-card {
    padding: 2.5rem 2rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition:
      transform var(--duration-base) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      color var(--duration-base) var(--ease-standard),
      opacity var(--duration-base) var(--ease-standard);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  @media (prefers-color-scheme: dark) {
    .skill-card {
      background: rgba(255, 255, 255, 0.05);
    }
  }

  html.dark .skill-card {
    background: rgba(255, 255, 255, 0.05);
  }

  html.light .skill-card {
    background: rgba(0, 0, 0, 0.03);
  }

  /* Hover: only the icon moves. The card itself stays still. */

  /* Skill Card Icon */

  .skill-card__icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-accent-primary) 10%, transparent) 0%,
      color-mix(in srgb, var(--color-accent-dark) 5%, transparent) 100%
    );
    color: var(--color-accent-primary);
    transition:
      transform var(--duration-base) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      color var(--duration-base) var(--ease-standard),
      opacity var(--duration-base) var(--ease-standard);
  }

  .skill-card:hover .skill-card__icon {
    background: linear-gradient(
      135deg,
      var(--color-accent-primary) 0%,
      var(--color-accent-dark) 100%
    );
    color: white;
    transform: rotate(8deg);
  }

  .skill-card__icon svg {
    width: 24px;
    height: 24px;
  }

  /* Skill Card Title */

  .skill-card__title {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    font-style: normal;
  }

  /* Skill Items */

  .skill-card__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .skill-item {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 6px;
    font-size: var(--text-sm);
    font-weight: 500;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
    white-space: nowrap;
  }

  @media (prefers-color-scheme: dark) {
    .skill-item {
      background: rgba(255, 255, 255, 0.08);
    }
  }

  html.dark .skill-item {
    background: rgba(255, 255, 255, 0.08);
  }

  html.light .skill-item {
    background: rgba(0, 0, 0, 0.04);
  }

  /* Phones: compact cards, with the icon and title on one row and the tags below. */
  @media (max-width: 768px) {
    .skills-grid {
      gap: 1rem;
    }

    .skill-card {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      column-gap: 1rem;
      row-gap: 0.875rem;
      padding: 1.25rem;
    }

    .skill-card__icon {
      width: 2.75rem;
      height: 2.75rem;
      margin: 0;
    }

    .skill-card__items {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 414px) {
    .skills-section-new {
      padding: 3rem 1.5rem;
    }

    .skills-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .skill-card {
      padding: 2rem 1.5rem;
    }

    .skill-item {
      font-size: var(--text-xs);
      padding: 0.4rem 0.8rem;
    }
  }

  @media (min-width: 415px) and (max-width: 767px) {
    .skills-section-new {
      padding: 4rem 2rem;
    }

    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (min-width: 768px) {
    .skills-section-new {
      padding: 8rem 2rem;
    }

    .skills-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }
  }

  .skills-focus {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .focus-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
  }

  .focus-card__index {
    font-family: 'Space Grotesk', sans-serif;
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent-primary);
  }

  .focus-card__title {
    margin: 0;
    font-family: 'Space Grotesk', sans-serif;
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .focus-card__text {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
</style>
